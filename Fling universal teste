-- ════════════════════════════════════════════════════════════
-- SAFE LAND (anti-dano de queda) — fly do infinity yield
-- ════════════════════════════════════════════════════════════
local _lastSafeLandTime = 0
local function safeLandAndFly()
    if tick() - _lastSafeLandTime < 1.0 then return end
    _lastSafeLandTime = tick()

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local refPos = State.MyOriginalCFrame and State.MyOriginalCFrame.Position or hrp.Position

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {char}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local origin = Vector3.new(refPos.X, refPos.Y + 50, refPos.Z)
    local result = workspace:Raycast(origin, Vector3.new(0, -1000, 0), rayParams)

    local groundY
    if result then
        groundY = result.Position.Y
    else
        groundY = refPos.Y
    end

    local finalCF = CFrame.new(refPos.X, groundY + CFG.SafeLandOffset, refPos.Z)

    pcall(function() hrp.CFrame = finalCF end)
    pcall(function()
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Velocity    = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "__SafeFlyBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name = "__SafeFlyBG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 3000
    bg.D = 500
    bg.CFrame = finalCF
    bg.Parent = hrp

    pcall(function() hum.PlatformStand = true end)

    task.wait(CFG.SafeFlyDuration)

    if bv and bv.Parent then bv:Destroy() end
    if bg and bg.Parent then bg:Destroy() end

    pcall(function()
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    pcall(function() hum.PlatformStand = false end)

    State.MyOriginalCFrame = nil
end

local function cleanupAndReturn()
    killFlingVelocity()
    removeNoclip()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hrp and hum then
        pcall(function() hum.PlatformStand = false end)
        pcall(function()
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.Velocity    = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end)
    end

    safeLandAndFly()

    State.SpikePaused = false
    State.SpikeStartTime = 0
    restoreMyCamera()
end

