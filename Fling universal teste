local function stopFloatTop()
    State.FloatTop = false
    State.FloatTopMoving = false
    State.FloatTopDir = nil
    State.SpikePaused = false
    State.SpikeStartTime = 0
    State.ActiveFlingTarget = nil
    FloatTopBtn.Text = "FLOAT TOP"
    FTStroke.Color = Color3.fromRGB(255, 100, 0)
    stopSpectate()
    cleanupAndReturn()
end

local function startFloatTop()
    if not State.Target and not State.AllMode then
        setStatus("Selecione um alvo ou ative ALL primeiro!", Color3.fromRGB(255, 120, 120))
        return
    end
    State.FloatTop = true
    State.FloatTopMoving = false
    State.FloatTopDir = nil
    State.SpikePaused = false
    State.SpikeStartTime = 0
    saveMyPosition()
    applyNoclip()
    FloatTopBtn.Text = "PARAR TOP"
    FTStroke.Color = Color3.fromRGB(255, 60, 60)

    local firstTarget = pickTarget("TOP")
    if firstTarget then spectate(firstTarget) end

    task.spawn(function()
        local stepDown = false

        while State.FloatTop do
            local char = LocalPlayer.Character
            if not char then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(0.2)
                char = LocalPlayer.Character
            end

            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    hum.PlatformStand = true

                    if hrp.Position.Y < CFG.VoidY + 15 then
                        if State.MyOriginalCFrame then
                            pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                        end
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity  = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        setStatus("Me safei do void!", Color3.fromRGB(255, 180, 100))
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "__BigHitbox" and not d.Name:find("__PrisonHitbox") then
                            local isTorso = (d.Name == "UpperTorso" or d.Name == "Torso")
                            if d.CanCollide ~= isTorso then
                                d.CanCollide = isTorso
                            end
                        end
                    end

                    local target = pickTarget("TOP")

                    if target and isPlayerGone(target) then
                        if State.AllMode then
                            local alive = getAliveOthers()
                            if #alive > 0 then
                                State.AllIndex = (State.AllIndex % #alive) + 1
                                State.AllTargetStart = tick()
                                State.AllTargetStartY = nil
                                State.SpikePaused = false
                                State.SpikeStartTime = 0
                                RunService.Heartbeat:Wait()
                                continue
                            else
                                setStatus("Todos saíram — parando", Color3.fromRGB(255, 120, 120))
                                State.FloatTop = false
                                break
                            end
                        else
                            setStatus("Alvo saiu do jogo — parando", Color3.fromRGB(255, 120, 120))
                            State.Target = nil
                            State.FloatTop = false
                            break
                        end
                    end

                    if not target or isDead(target) then
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        State.SpikePaused = false
                        State.SpikeStartTime = 0
                        if State.AllMode then
                            setStatus("Aguardando respawn... (" .. #getAliveOthers() .. " vivos)", Color3.fromRGB(255, 180, 100))
                        else
                            setStatus("Alvo morreu — aguardando respawn...", Color3.fromRGB(255, 180, 100))
                        end
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    if target then
                        State.ActiveFlingTarget = target
                        local tRoot = getRoot(target)
                        local tHum = getHumanoid(target)
                        local tTorso = getTorso(target)

                        if tRoot and tRoot.Parent then
                            local spiked = shouldPauseForSpike(target)
                            if spiked then
                                if not State.SpikePaused then
                                    State.SpikePaused = true
                                    State.SpikeStartTime = tick()
                                    killFlingVelocity()
                                    pcall(function()
                                        hrp.AssemblyLinearVelocity  = Vector3.zero
                                        hrp.AssemblyAngularVelocity = Vector3.zero
                                        hrp.Velocity    = Vector3.zero
                                        hrp.RotVelocity = Vector3.zero
                                    end)
                                    setStatus("SPIKE — top pausado", Color3.fromRGB(255, 220, 100))
                                end

                                if State.MyOriginalCFrame then
                                    pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                                end
                                hum.PlatformStand = true

                                if not State.Spectating then spectate(target) end

                                RunService.Heartbeat:Wait()
                                continue
                            else
                                if State.SpikePaused then
                                    State.SpikePaused = false
                                    State.SpikeStartTime = 0
                                    setStatus("Spike acabou — top retomando!", Color3.fromRGB(100, 255, 150))
                                end

                                stepDown = not stepDown
                                local yOffset = stepDown and -CFG.FloatTopStepDown or 0

                                local refPos = (tTorso and tTorso.Position) or tRoot.Position

                                local targetVel = tRoot.AssemblyLinearVelocity.Magnitude
                                if targetVel >= CFG.MoveVelocityThreshold then
                                    State.FloatTopMoving = true
                                elseif targetVel < CFG.StopVelocityThreshold then
                                    State.FloatTopMoving = false
                                    State.FloatTopDir = nil
                                end
                                local isMoving = State.FloatTopMoving

                                if isMoving then
                                    local newDir = getMoveDir(tRoot, tHum)
                                    State.FloatTopDir = updateLockedDir(State.FloatTopDir, newDir)
                                end
                                local moveDir = State.FloatTopDir or Vector3.zero
                                local hasMoveDir = moveDir.Magnitude > 0.1

                                local velY = tRoot.AssemblyLinearVelocity.Y
                                local isRising = velY > CFG.FloatRisingThreshold

                                local basePos
                                if isRising and isMoving and hasMoveDir then
                                    basePos = refPos
                                        + (moveDir * CFG.FloatTopFrontOffset)
                                        + Vector3.new(0, CFG.FloatRisingOffset, 0)
                                elseif isRising then
                                    basePos = refPos + Vector3.new(0, CFG.FloatRisingOffset, 0)
                                elseif isMoving and hasMoveDir then
                                    basePos = refPos
                                        + (moveDir * CFG.FloatTopFrontOffset)
                                        + Vector3.new(0, CFG.FloatTopOffset, 0)
                                else
                                    basePos = refPos + Vector3.new(0, CFG.FloatTopOffset, 0)
                                end

                                local posDest = basePos + Vector3.new(0, yOffset, 0)

                                hrp.CFrame = CFrame.lookAt(posDest, posDest + Vector3.new(0, -1, 0))

                                hrp.Velocity    = Vector3.new(0, CFG.FloatTopVelocity, 0)
                                hrp.RotVelocity = Vector3.zero

                                local bv = hrp:FindFirstChild("FlingVelocity")
                                if not bv then
                                    bv = Instance.new("BodyVelocity")
                                    bv.Name = "FlingVelocity"
                                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bv.Parent = hrp
                                end
                                bv.Velocity = Vector3.new(0, CFG.FloatTopVelocity, 0)

                                local mode
                                if isRising and isMoving and hasMoveDir then
                                    mode = "acima+frente (subindo e andando)"
                                elseif isRising then
                                    mode = "acima " .. CFG.FloatRisingOffset .. " studs (subindo)"
                                elseif isMoving and hasMoveDir then
                                    mode = "à frente " .. CFG.FloatTopFrontOffset .. " studs em cima [dir travada]"
                                else
                                    mode = "1 stud acima do torso"
                                end
                                setStatus("FLOAT TOP em " .. target.Name .. " ☁️⬇️ (" .. mode .. ")", Color3.fromRGB(255, 180, 120))
                            end
                        end
                    end
                end
            end

            RunService.Heartbeat:Wait()
        end

        stopFloatTop()
    end)
end

