-- ============ UTILS ============
local function findPlayerByQuery(q)
    if not q or q == "" then return nil end
    q = tostring(q):lower():gsub("%s", "")
    local matches = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local n = p.Name:lower():gsub("%s", "")
            local d = (p.DisplayName or ""):lower():gsub("%s", "")
            if n:find(q, 1, true) or d:find(q, 1, true) then table.insert(matches, p) end
        end
    end
    local best, bs
    for _, p in ipairs(matches) do
        local n = p.Name:lower():gsub("%s", "")
        local d = (p.DisplayName or ""):lower():gsub("%s", "")
        local s = math.min(n:len(), d:len() > 0 and d:len() or 9999)
        if not best or s < bs then best = p; bs = s end
    end
    return best
end

local function isPlayerGone(p)
    if not p then return true end
    local ok, parent = pcall(function() return p.Parent end)
    if not ok or parent ~= Players then return true end
    if not Players:FindFirstChild(p.Name) then return true end
    return false
end

local function getChar(p) if not p then return nil end return p.Character end
local function getRoot(p) local c = getChar(p) if not c then return nil end return c:FindFirstChild("HumanoidRootPart") end
local function getHumanoid(p) local c = getChar(p) if not c then return nil end return c:FindFirstChildOfClass("Humanoid") end
local function getTorso(p)
    local c = getChar(p)
    if not c then return nil end
    return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
end
local function setStatus(t, c)
    TargetStatus.Text = t
    TargetStatus.TextColor3 = c or Color3.fromRGB(120, 220, 255)
end

local function getAliveOthers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and p.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function isDead(p)
    if not p then return true end
    local char = p.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    return hum.Health <= 0
end

local function getTargetVelocity(p)
    local r = getRoot(p)
    if not r then return 0 end
    return r.AssemblyLinearVelocity.Magnitude
end

local function isTargetInAir(target, startY)
    if not target then return false end
    local root = getRoot(target)
    if not root then return false end

    if root.AssemblyLinearVelocity.Y > CFG.AirVelocityThreshold then
        return true
    end
    if startY and (root.Position.Y - startY) > CFG.AirHeightThreshold then
        return true
    end
    return false
end

local function checkSpike(p)
    local v = getTargetVelocity(p)
    if v > CFG.SpikeThreshold then return true, v end
    return false, v
end

local function wentToVoid(p)
    local r = getRoot(p)
    if not r then return false end
    return r.Position.Y < CFG.VoidY
end

local function isTargetSafe(target)
    local r = getRoot(target)
    if not r then return false end
    if r.Position.Y < CFG.VoidY + CFG.SpikeResumeMinHeight then
        return false
    end
    if r.AssemblyLinearVelocity.Y < CFG.SpikeResumeMaxFallSpeed then
        return false
    end
    return true
end

local function getMoveDir(tRoot, tHum)
    local v = tRoot.AssemblyLinearVelocity
    local flat = Vector3.new(v.X, 0, v.Z)
    if flat.Magnitude > 0.1 then
        return flat.Unit
    elseif tHum and tHum.MoveDirection.Magnitude > 0.1 then
        return tHum.MoveDirection.Unit
    end
    return Vector3.zero
end

local function updateLockedDir(currentDir, newDir)
    if newDir.Magnitude < 0.1 then return currentDir end
    if not currentDir or currentDir.Magnitude < 0.1 then
        return newDir
    end
    local dot = math.clamp(currentDir:Dot(newDir), -1, 1)
    local angle = math.deg(math.acos(dot))
    if angle > CFG.DirectionChangeThreshold then
        return newDir
    end
    return currentDir
end

local function getSwapTime()
    if State.AllVersion == "v2" then
        return State.AllSpeedV2
    end
    return CFG.AllSwapTime
end

local function shouldPauseForSpike(target)
    local v = getTargetVelocity(target)
    if v <= CFG.SpikeThreshold then
        return false, v
    end
    if State.SpikePaused and (tick() - State.SpikeStartTime) > CFG.SpikeMaxDuration then
        if isTargetSafe(target) then
            return false, v
        end
    end
    return true, v
end

local function pickTarget(statusLabel)
    if State.AllMode then
        local alive = getAliveOthers()
        if #alive > 0 then
            if State.AllIndex < 1 or State.AllIndex > #alive then
                State.AllIndex = 1
                State.AllTargetStart = tick()
                State.AllTargetStartY = nil
            end
            if State.AllTargetStart == 0 then
                State.AllTargetStart = tick()
                State.AllTargetStartY = nil
            end

            local currentTarget = alive[State.AllIndex]
            local tRoot = getRoot(currentTarget)

            local shouldSwap = false
            local reason = "tempo"

            if State.AllVersion == "v1" then
                if tick() - State.AllTargetStart >= CFG.AllSwapTime then
                    shouldSwap = true
                    reason = "tempo"
                end

                if tRoot then
                    if not State.AllTargetStartY then
                        State.AllTargetStartY = tRoot.Position.Y
                    end

                    local roseTooHigh = tRoot.Position.Y > State.AllTargetStartY + CFG.AllFlyThreshold
                    local wentVoid = tRoot.Position.Y < CFG.VoidY
                    local highVel = tRoot.AssemblyLinearVelocity.Magnitude > CFG.SpikeThreshold

                    if roseTooHigh or wentVoid or highVel then
                        shouldSwap = true
                        reason = roseTooHigh and "voou ↑" or (wentVoid and "void" or "spike")
                    end
                end
            else
                if tick() - State.AllTargetStart >= getSwapTime() then
                    shouldSwap = true
                    reason = "v2 " .. getSwapTime() .. "s"
                end
            end

            if shouldSwap then
                State.AllIndex = (State.AllIndex % #alive) + 1
                State.AllTargetStart = tick()
                State.AllTargetStartY = nil
                State.SpikePaused = false
                State.SpikeStartTime = 0
                if statusLabel then
                    setStatus(statusLabel .. " [" .. reason .. "]: " .. alive[State.AllIndex].Name .. " (" .. #alive .. ")", Color3.fromRGB(100, 255, 200))
                end
            end

            return alive[State.AllIndex]
        end
        return nil
    else
        return State.Target
    end
end

