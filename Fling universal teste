-- ════════════════════════════════════════════════════════════
-- ═══════════════════ CLICK FLING TOOLS (TOGGLE) ═════════════
-- ════════════════════════════════════════════════════════════
local ALL_CLICK_TOOLS = { "ClickFlingTool", "ClickFloatTool", "ClickFloatTopTool" }

local function hasTool(toolName)
    local char = LocalPlayer.Character
    if char then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and c.Name == toolName then return true end
        end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") and c.Name == toolName then return true end
        end
    end
    return false
end

local function removeTool(toolName)
    local char = LocalPlayer.Character
    if char then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and c.Name == toolName then
                pcall(function() c:Destroy() end)
            end
        end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") and c.Name == toolName then
                pcall(function() c:Destroy() end)
            end
        end
    end
end

local function removeAllClickTools()
    for _, n in ipairs(ALL_CLICK_TOOLS) do
        removeTool(n)
    end
    State.ClickFlingTool = nil
    State.ClickFlingToolName = nil
end

local function clickToolCleanup()
    killFlingVelocity()
    removeNoclip()
    local char = LocalPlayer.Character
