local function switchTab(tab)
    State.ActiveTab = tab
    if tab == "fling" then
        FlingContent.Visible = true
        ClickContent.Visible = false
        FlingTabBtn.TextColor3 = Color3.fromRGB(0, 230, 255)
        FlingTabStroke.Color = Color3.fromRGB(0, 230, 255)
        FlingTabStroke.Transparency = 0.2
        FlingTabBtn.BackgroundTransparency = 0.3
        ClickTabBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
        ClickTabStroke.Color = Color3.fromRGB(120, 120, 140)
        ClickTabStroke.Transparency = 0.4
        ClickTabBtn.BackgroundTransparency = 0.5
    else
        FlingContent.Visible = false
        ClickContent.Visible = true
        ClickTabBtn.TextColor3 = Color3.fromRGB(255, 100, 200)
        ClickTabStroke.Color = Color3.fromRGB(255, 100, 200)
        ClickTabStroke.Transparency = 0.2
        ClickTabBtn.BackgroundTransparency = 0.3
        FlingTabBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
        FlingTabStroke.Color = Color3.fromRGB(120, 120, 140)
        FlingTabStroke.Transparency = 0.4
        FlingTabBtn.BackgroundTransparency = 0.5
    end
end

