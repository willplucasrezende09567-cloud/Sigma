local function startWalkFling(mode)
    State.WalkFling = true
    State.VoidDetected = false
    State.AllTargetStart = tick()
    State.AllTargetStartY = nil
    State.SpikePaused = false
    State.SpikeStartTime = 0
    State.FlingMode = mode or "loop"
    if State.FlingMode == "timed" then
        State.FlingEndTime = tick() + CFG.Fling2sDuration
    else
        State.FlingEndTime = 0
    end
    saveMyPosition()
    applyNoclip()
    syncHitbox()

    if State.FlingMode == "timed" then
        Fling2sBtn.Text = "PARAR 1.3s"
        F4Stroke.Color = Color3.fromRGB(255, 60, 60)
    else
        FlingLoopBtn.Text = "PARAR LOOP"
        FLStroke.Color = Color3.fromRGB(255, 60, 60)
    end

    spectate(State.AllMode and (getAliveOthers()[1] or State.Target) or State.Target)

    task.spawn(function()
        while State.WalkFling do
            if State.FlingMode == "timed" and tick() >= State.FlingEndTime then
                setStatus("Tempo esgotado — parando", Color3.fromRGB(200, 200, 200))
                State.WalkFling = false
                break
            end

            local char = LocalPlayer.Character
            if not char then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(0.2)
                char = LocalPlayer.Character
            end

            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    hum.PlatformStand = true

                    if hrp.Position.Y < CFG.VoidY + 15 then
                        if State.MyOriginalCFrame then
                            pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                        end
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity  = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        setStatus("Me safei do void!", Color3.fromRGB(255, 180, 100))
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "__BigHitbox" then
                            local isTorso = (d.Name == "UpperTorso" or d.Name == "Torso")
                            if d.CanCollide ~= isTorso then
                                d.CanCollide = isTorso
                            end
                        end
                    end

                    local target = pickTarget("FLING")

                    if target and isPlayerGone(target) then
                        if State.AllMode then
                            local alive = getAliveOthers()
                            if #alive > 0 then
                                State.AllIndex = (State.AllIndex % #alive) + 1
                                State.AllTargetStart = tick()
                                State.AllTargetStartY = nil
                                State.SpikePaused = false
                                State.SpikeStartTime = 0
                                RunService.Heartbeat:Wait()
                                continue
                            else
                                setStatus("Todos saíram — parando", Color3.fromRGB(255, 120, 120))
                                State.WalkFling = false
                                break
                            end
                        else
                            setStatus("Alvo saiu do jogo — parando", Color3.fromRGB(255, 120, 120))
                            State.Target = nil
                            State.WalkFling = false
                            break
                        end
                    end

                    if not target or isDead(target) then
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        State.SpikePaused = false
                        State.SpikeStartTime = 0
                        if State.AllMode then
                            setStatus("Aguardando respawn... (" .. #getAliveOthers() .. " vivos)", Color3.fromRGB(255, 180, 100))
                        else
                            setStatus("Alvo morreu — aguardando respawn...", Color3.fromRGB(255, 180, 100))
                        end
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    if wentToVoid(target) then
                        if State.AllMode then
                            local alive = getAliveOthers()
                            if #alive > 0 then
                                State.AllIndex = (State.AllIndex % #alive) + 1
                                State.AllTargetStart = tick()
                                State.AllTargetStartY = nil
                                State.SpikePaused = false
                                State.SpikeStartTime = 0
                                RunService.Heartbeat:Wait()
                                continue
                            end
                        end
                        killFlingVelocity()
                        setStatus("Alvo caiu — aguardando...", Color3.fromRGB(255, 180, 100))
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    if target then
                        State.ActiveFlingTarget = target

                        local tRoot = getRoot(target)
                        local tHum = getHumanoid(target)
                        local tTorso = getTorso(target)

                        if tRoot and tRoot.Parent then
                            local spiked = false
                            if State.AllVersion == "v1" then
                                spiked = shouldPauseForSpike(target)
                            end

                            if spiked then
                                if not State.SpikePaused then
                                    State.SpikePaused = true
                                    State.SpikeStartTime = tick()
                                    killFlingVelocity()
                                    pcall(function()
                                        hrp.AssemblyLinearVelocity  = Vector3.zero
                                        hrp.AssemblyAngularVelocity = Vector3.zero
                                        hrp.Velocity    = Vector3.zero
                                        hrp.RotVelocity = Vector3.zero
                                    end)
                                    setStatus("SPIKE [V1] — pausado (espectando " .. target.Name .. ")", Color3.fromRGB(255, 220, 100))
                                end

                                if State.MyOriginalCFrame then
                                    pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                                end
                                hum.PlatformStand = true

                                if not State.Spectating then spectate(target) end

                                RunService.Heartbeat:Wait()
                                continue
                            else
                                if State.SpikePaused then
                                    State.SpikePaused = false
                                    State.SpikeStartTime = 0
                                    setStatus("Spike acabou — retomando!", Color3.fromRGB(100, 255, 150))
                                end

                                if tRoot.Position.Y < CFG.VoidY + 40 then
                                    RunService.Heartbeat:Wait()
                                    continue
                                end

                                local targetVel = tRoot.AssemblyLinearVelocity.Magnitude
                                local isMoving = targetVel >= CFG.MoveVelocityThreshold
                                local moveDir = getMoveDir(tRoot, tHum)

                                local posDestino, olharPara

                                if isMoving and moveDir.Magnitude > 0.1 then
                                    posDestino = tRoot.Position + (moveDir * CFG.FrontOffset)
                                    olharPara = (tTorso and tTorso.Position) or tRoot.Position
                                else
                                    local tPos = (tTorso and tTorso.Position) or tRoot.Position
                                    posDestino = tPos
                                    local tLook = (tTorso and tTorso.CFrame.LookVector) or tRoot.CFrame.LookVector
                                    olharPara = tPos + tLook
                                end

                                hrp.CFrame = CFrame.new(posDestino, olharPara)

                                local direcao = (tRoot.Position - hrp.Position)
                                if direcao.Magnitude < 0.1 then
                                    direcao = tRoot.CFrame.LookVector
                                else
                                    direcao = direcao.Unit
                                end

                                hrp.Velocity    = direcao * CFG.FlingVelocity
                                hrp.RotVelocity = Vector3.new(9000, 9000, 9000)

                                local bv = hrp:FindFirstChild("FlingVelocity")
                                if not bv then
                                    bv = Instance.new("BodyVelocity")
                                    bv.Name = "FlingVelocity"
                                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bv.Parent = hrp
                                end
                                bv.Velocity = direcao * CFG.FlingVelocity
                            end
                        end
                    end
                end
            end

            RunService.Heartbeat:Wait()
        end

        stopWalkFling(State.AllMode)
    end)
end

