local function clickToolLoop()
    while true do
        local anyActive = State.ClickFlingToolActive or State.ClickFloatToolActive or State.ClickFloatTopToolActive
        if not anyActive then
            break
        end

        if State.ClickFlingActive and State.ClickFlingTarget and State.ClickFlingMode then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local target = State.ClickFlingTarget
                local mode = State.ClickFlingMode

                if hrp and hum then
                    hum.PlatformStand = true

                    if hrp.Position.Y < CFG.VoidY + 15 then
                        if State.MyOriginalCFrame then
                            pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                        end
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity  = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "__BigHitbox" then
                            local isTorso = (d.Name == "UpperTorso" or d.Name == "Torso")
                            if d.CanCollide ~= isTorso then
                                d.CanCollide = isTorso
                            end
                        end
                    end

                    if not target or isDead(target) or isPlayerGone(target) then
                        clickToolCleanup()
                        setStatus("Click — alvo morreu/saiu (safe land + fly)", Color3.fromRGB(255, 120, 120))
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    local tRoot = getRoot(target)
                    local tHum = getHumanoid(target)
                    local tTorso = getTorso(target)

                    if tRoot and tRoot.Parent then
                        local spiked = checkSpike(target)
                        if spiked then
                            clickToolCleanup()
                            setStatus("SPIKE — click parado (safe land + fly). Clique denovo pra retomar", Color3.fromRGB(255, 220, 100))
                            RunService.Heartbeat:Wait()
                            continue
                        end

                        if mode == "float" or mode == "floattop" then
                            if isTargetInAir(target, State.ClickTargetStartY) then
                                State.ClickAirFrames = State.ClickAirFrames + 1
                            else
                                State.ClickAirFrames = 0
                            end
                            if State.ClickAirFrames >= CFG.AirMinFrames then
                                clickToolCleanup()
                                setStatus("Alvo no ar — click " .. mode .. " parado (safe land + fly)", Color3.fromRGB(255, 180, 100))
                                RunService.Heartbeat:Wait()
                                continue
                            end
                        end

                        if mode == "fling" then
                            local targetVel = tRoot.AssemblyLinearVelocity.Magnitude
                            local isMoving = targetVel >= CFG.MoveVelocityThreshold
                            local moveDir = getMoveDir(tRoot, tHum)

                            local posDestino, olharPara
                            if isMoving and moveDir.Magnitude > 0.1 then
                                posDestino = tRoot.Position + (moveDir * CFG.FrontOffset)
                                olharPara = (tTorso and tTorso.Position) or tRoot.Position
                            else
                                local tPos = (tTorso and tTorso.Position) or tRoot.Position
                                posDestino = tPos
                                local tLook = (tTorso and tTorso.CFrame.LookVector) or tRoot.CFrame.LookVector
                                olharPara = tPos + tLook
                            end

                            hrp.CFrame = CFrame.new(posDestino, olharPara)

                            local direcao = (tRoot.Position - hrp.Position)
                            if direcao.Magnitude < 0.1 then
                                direcao = tRoot.CFrame.LookVector
                            else
                                direcao = direcao.Unit
                            end

                            hrp.Velocity    = direcao * CFG.FlingVelocity
                            hrp.RotVelocity = Vector3.new(9000, 9000, 9000)

                            local bv = hrp:FindFirstChild("FlingVelocity")
                            if not bv then
                                bv = Instance.new("BodyVelocity")
                                bv.Name = "FlingVelocity"
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Parent = hrp
                            end
                            bv.Velocity = direcao * CFG.FlingVelocity

                        elseif mode == "float" then
                            if not State.clickFloatStepUpState then State.clickFloatStepUpState = false end
                            State.clickFloatStepUpState = not State.clickFloatStepUpState
                            local yOffset = State.clickFloatStepUpState and CFG.FloatStepUp or 0

                            local refPos = (tTorso and tTorso.Position) or tRoot.Position

                            local targetVel = tRoot.AssemblyLinearVelocity.Magnitude
                            if targetVel >= CFG.MoveVelocityThreshold then
                                State.ClickFloatMoving = true
                            elseif targetVel < CFG.StopVelocityThreshold then
                                State.ClickFloatMoving = false
                                State.ClickFloatDir = nil
                            end
                            local isMoving = State.ClickFloatMoving

                            if isMoving then
                                local newDir = getMoveDir(tRoot, tHum)
                                State.ClickFloatDir = updateLockedDir(State.ClickFloatDir, newDir)
                            end
                            local moveDir = State.ClickFloatDir or Vector3.zero
                            local hasMoveDir = moveDir.Magnitude > 0.1

                            local velY = tRoot.AssemblyLinearVelocity.Y
                            local isFalling = velY < CFG.FloatFallThreshold
                            local isRising = velY > CFG.FloatRisingThreshold

                            local basePos
                            if isRising and isMoving and hasMoveDir then
                                basePos = refPos + (moveDir * CFG.FloatFrontOffset) + Vector3.new(0, CFG.FloatRisingOffset, 0)
                            elseif isRising then
                                basePos = refPos + Vector3.new(0, CFG.FloatRisingOffset, 0)
                            elseif isFalling and isMoving and hasMoveDir then
                                basePos = refPos + (moveDir * CFG.FloatFrontOffset) - Vector3.new(0, CFG.FloatFallOffset, 0)
                            elseif isFalling then
                                basePos = refPos - Vector3.new(0, CFG.FloatFallOffset, 0)
                            elseif isMoving and hasMoveDir then
                                basePos = refPos + (moveDir * CFG.FloatFrontOffset)
                            else
                                basePos = refPos - Vector3.new(0, CFG.FloatOffset, 0)
                            end

                            local posDest = basePos + Vector3.new(0, yOffset, 0)

                            hrp.CFrame = CFrame.lookAt(posDest, posDest + Vector3.new(0, 1, 0))

                            hrp.Velocity    = Vector3.new(0, CFG.FloatVelocity, 0)
                            hrp.RotVelocity = Vector3.zero

                            local bv = hrp:FindFirstChild("FlingVelocity")
                            if not bv then
                                bv = Instance.new("BodyVelocity")
                                bv.Name = "FlingVelocity"
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Parent = hrp
                            end
                            bv.Velocity = Vector3.new(0, CFG.FloatVelocity, 0)

                        elseif mode == "floattop" then
                            -- Para automático se a velocidade do alvo passar do limite
                            local curSpeedTop = tRoot.AssemblyLinearVelocity.Magnitude
                            if curSpeedTop > CFG.FloatTopStopVelocity then
                                clickToolCleanup()
                                setStatus("Alvo em movimento (" .. math.floor(curSpeedTop) .. " > " .. CFG.FloatTopStopVelocity .. ") — click float top parado", Color3.fromRGB(255, 180, 100))
                                RunService.Heartbeat:Wait()
                                continue
                            end

                            if not State.clickFloatTopStepState then State.clickFloatTopStepState = false end
                            State.clickFloatTopStepState = not State.clickFloatTopStepState
                            local yOffset = State.clickFloatTopStepState and -CFG.FloatTopStepDown or 0

                            local refPos = (tTorso and tTorso.Position) or tRoot.Position

                            local targetVel = tRoot.AssemblyLinearVelocity.Magnitude
                            if targetVel >= CFG.MoveVelocityThreshold then
                                State.ClickFloatTopMoving = true
                            elseif targetVel < CFG.StopVelocityThreshold then
                                State.ClickFloatTopMoving = false
                                State.ClickFloatTopDir = nil
                            end
                            local isMoving = State.ClickFloatTopMoving

                            if isMoving then
                                local newDir = getMoveDir(tRoot, tHum)
                                State.ClickFloatTopDir = updateLockedDir(State.ClickFloatTopDir, newDir)
                            end
                            local moveDir = State.ClickFloatTopDir or Vector3.zero
                            local hasMoveDir = moveDir.Magnitude > 0.1

                            local velY = tRoot.AssemblyLinearVelocity.Y
                            local isRising = velY > CFG.FloatRisingThreshold

                            local basePos
                            if isRising and isMoving and hasMoveDir then
                                basePos = refPos + (moveDir * CFG.FloatTopFrontOffset) + Vector3.new(0, CFG.FloatRisingOffset, 0)
                            elseif isRising then
                                basePos = refPos + Vector3.new(0, CFG.FloatRisingOffset, 0)
                            elseif isMoving and hasMoveDir then
                                basePos = refPos + (moveDir * CFG.FloatTopFrontOffset) + Vector3.new(0, CFG.FloatTopOffset, 0)
                            else
                                basePos = refPos + Vector3.new(0, CFG.FloatTopOffset, 0)
                            end

                            local posDest = basePos + Vector3.new(0, yOffset, 0)

                            hrp.CFrame = CFrame.lookAt(posDest, posDest + Vector3.new(0, -1, 0))

                            hrp.Velocity    = Vector3.new(0, CFG.FloatTopVelocity, 0)
                            hrp.RotVelocity = Vector3.zero

                            local bv = hrp:FindFirstChild("FlingVelocity")
                            if not bv then
                                bv = Instance.new("BodyVelocity")
                                bv.Name = "FlingVelocity"
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Parent = hrp
                            end
                            bv.Velocity = Vector3.new(0, CFG.FloatTopVelocity, 0)
                        end
                    end
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end

local _clickLoopRunning = false
