end

local function giveClickTool(toolName, mode, silent)
    local def = TOOL_DEFS[toolName]
    if not def then return end

    if hasTool(toolName) then
        if not silent then
            setStatus("Você já tem a " .. toolName .. "!", Color3.fromRGB(255, 200, 100))
        end
        return
    end
    removeTool(toolName)

    local tool = Instance.new("Tool")
    tool.Name = toolName
    tool.RequiresHandle = false
    tool.CanBeDropped = false

    local tooltip = "Clique em um jogador"
    if mode == "fling" then tooltip = "Click Fling — clique num player"
    elseif mode == "float" then tooltip = "Click Float — clique num player"
    elseif mode == "floattop" then tooltip = "Click Float Top — clique num player" end
    tool.ToolTip = tooltip

    tool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if not mouse or not mouse.Target then return end
        local model = mouse.Target:FindFirstAncestorOfClass("Model")
        if not model then return end
        local plr = Players:GetPlayerFromCharacter(model)
        if plr and plr ~= LocalPlayer then
            clickToolToggle(plr, mode, toolName)
        else
            setStatus("Clique em um jogador!", Color3.fromRGB(255, 200, 100))
        end
    end)

    tool.Destroying:Connect(function()
        if State.ClickFlingTool == tool then
            State.ClickFlingTool = nil
            State.ClickFlingToolName = nil
            if not (State.ClickFlingToolActive or State.ClickFloatToolActive or State.ClickFloatTopToolActive) then
                clickToolCleanup()
            end
        end
    end)

    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        tool.Parent = bp
    else
        tool.Parent = LocalPlayer.Character or LocalPlayer
    end

    State.ClickFlingTool = tool
    State.ClickFlingToolName = toolName

    ensureClickLoop()

    if not silent then
        setStatus(toolName .. " recebida! Equipe e clique num player", Color3.fromRGB(255, 150, 220))
    end
end

local function setClickToolToggled(toolName)
    local def = TOOL_DEFS[toolName]
    if not def then return end

    local newState = not State[def.stateKey]
    State[def.stateKey] = newState

    if newState then
        giveClickTool(toolName, def.mode, true)
        setStatus(toolName .. " ATIVADO — mantém mesmo após morrer", Color3.fromRGB(120, 255, 150))
    else
        removeTool(toolName)
        if State.ClickFlingToolName == toolName then
            State.ClickFlingTool = nil
            State.ClickFlingToolName = nil
        end
        if not (State.ClickFlingToolActive or State.ClickFloatToolActive or State.ClickFloatTopToolActive) then
            clickToolCleanup()
        end
        setStatus(toolName .. " DESATIVADO — Tool removida", Color3.fromRGB(255, 150, 150))
    end

    updateToolBtnUI(toolName)
end

