local function applyBigHitbox()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if State.BigHitboxPart and State.BigHitboxPart.Parent then
        pcall(function() State.BigHitboxPart:Destroy() end)
    end

    local box = Instance.new("Part")
    box.Name = "__BigHitbox"
    box.Shape = Enum.PartType.Ball
    box.Size = Vector3.new(CFG.BigHitboxSize, CFG.BigHitboxSize, CFG.BigHitboxSize)
    box.CanCollide = true
    box.CanTouch = true
    box.CanQuery = true
    box.Anchored = false
    box.Massless = true
    box.Transparency = CFG.BigHitboxAlpha
    box.Color = Color3.fromRGB(0, 200, 255)
    box.Material = Enum.Material.ForceField
    box.CFrame = hrp.CFrame
    box.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Name = "__BigHitboxWeld"
    weld.Part0 = hrp
    weld.Part1 = box
    weld.Parent = box

    pcall(function() box:SetNetworkOwner(LocalPlayer) end)

    State.BigHitboxPart = box
    State.BigHitboxActive = true

    task.spawn(function()
        while State.BigHitboxActive and box.Parent do
            local ch = LocalPlayer.Character
            local h = ch and ch:FindFirstChild("HumanoidRootPart")
            if h and not box:FindFirstChild("__BigHitboxWeld") then
                local w = Instance.new("WeldConstraint")
                w.Name = "__BigHitboxWeld"
                w.Part0 = h
                w.Part1 = box
                w.Parent = box
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function removeBigHitbox()
    if State.BigHitboxPart then
        pcall(function() State.BigHitboxPart:Destroy() end)
        State.BigHitboxPart = nil
    end
    State.BigHitboxActive = false
