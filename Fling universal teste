local function makeFlingButton(name, text, posX, sizeX, colorA, colorB)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(sizeX, -20, 0, 34)
    btn.Position = UDim2.new(posX, 15, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.BackgroundTransparency = 0.5
    btn.Text = text
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.AutoButtonColor = false
    btn.Parent = FlingContent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local str = Instance.new("UIStroke", btn)
    str.Thickness = 1.5; str.Color = colorA; str.Transparency = 0.3
    local grad = Instance.new("UIGradient", btn)
    grad.Color = ColorSequence.new(colorA, colorB)
    grad.Rotation = 90
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(1, 0.5),
    })
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.25}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.5}):Play() end)
    return btn, str
end

