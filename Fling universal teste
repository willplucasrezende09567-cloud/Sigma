local function startFrozenOrbit()
    if not State.Target and not State.AllMode then
        setStatus("Selecione um alvo ou ative ALL primeiro!", Color3.fromRGB(255, 120, 120))
        return
    end
    State.FrozenOrbit = true
    State.OrbitAngle = 0
    State.OrbitStep = false
    State.PrisonMoving = false
    State.PrisonDir = nil
    State.SpikePaused = false
    State.SpikeStartTime = 0
    saveMyPosition()
    FrozenBtn.Text = "PARAR PRISON"
    FZStroke.Color = Color3.fromRGB(255, 60, 60)

    local firstTarget = pickTarget("PRISON")
    if firstTarget then spectate(firstTarget) end

    task.spawn(function()
        local prisonParts = {}
        local offsetAngles = {}

        local function clearPrison()
            for _, p in ipairs(prisonParts) do
                pcall(function() p:Destroy() end)
            end
            prisonParts = {}
            offsetAngles = {}
        end

        local function createPrison()
            clearPrison()

            local count = CFG.PrisonPartCount
            local psize = CFG.PrisonPartSize

            for i = 1, count do
                local angle = ((i - 1) / count) * math.pi * 2
                table.insert(offsetAngles, angle)

                local box = Instance.new("Part")
                box.Name = "__PrisonHitbox_" .. i
                box.Shape = Enum.PartType.Ball
                box.Size = Vector3.new(psize, psize, psize)
                box.CanCollide = true
                box.CanTouch = true
                box.CanQuery = true
                box.Anchored = false
                box.Massless = false
                box.CustomPhysicalProperties = PhysicalProperties.new(50, 0.3, 0.5, 1, 1)
                box.Transparency = CFG.PrisonAlpha
                box.Color = Color3.fromRGB(100, 200, 255)
                box.Material = Enum.Material.ForceField
                box.CFrame = CFrame.new(0, -1000, 0)
                box.Parent = workspace

                pcall(function() box:SetNetworkOwner(LocalPlayer) end)

                table.insert(prisonParts, box)
            end

            State.PrisonParts = prisonParts
        end

        createPrison()

        while State.FrozenOrbit do
            local char = LocalPlayer.Character
            local myHrp = char and char:FindFirstChild("HumanoidRootPart")
            local myHum = char and char:FindFirstChildOfClass("Humanoid")

            if myHrp then
                pcall(function()
                    myHrp.AssemblyLinearVelocity = Vector3.zero
                    myHrp.AssemblyAngularVelocity = Vector3.zero
                    myHrp.Velocity = Vector3.zero
                    myHrp.RotVelocity = Vector3.zero
                end)
                if myHrp.Position.Y < CFG.VoidY + 15 and State.MyOriginalCFrame then
                    pcall(function() myHrp.CFrame = State.MyOriginalCFrame end)
                end
            end

            local target = pickTarget("PRISON")

            if target and isPlayerGone(target) then
                if State.AllMode then
                    local alive = getAliveOthers()
                    if #alive > 0 then
                        State.AllIndex = (State.AllIndex % #alive) + 1
                        State.AllTargetStart = tick()
                        State.AllTargetStartY = nil
                        State.SpikePaused = false
                        State.SpikeStartTime = 0
                        RunService.Heartbeat:Wait()
                        continue
                    else
                        setStatus("Todos saíram — parando", Color3.fromRGB(255, 120, 120))
                        State.FrozenOrbit = false
                        break
                    end
                else
                    setStatus("Alvo saiu do jogo — parando", Color3.fromRGB(255, 120, 120))
                    State.Target = nil
                    State.FrozenOrbit = false
                    break
                end
            end

            if not target or isDead(target) then
                setStatus(State.AllMode and ("Aguardando respawn... (" .. #getAliveOthers() .. " vivos)") or "Alvo morreu — aguardando respawn...", Color3.fromRGB(255, 180, 100))

                for _, box in ipairs(prisonParts) do
                    if box and box.Parent then
                        box.CFrame = CFrame.new(0, -1000, 0)
                    end
                end

                RunService.Heartbeat:Wait()
                continue
            end

            if wentToVoid(target) then
                if State.AllMode then
                    local alive = getAliveOthers()
                    if #alive > 0 then
                        State.AllIndex = (State.AllIndex % #alive) + 1
                        State.AllTargetStart = tick()
                        State.AllTargetStartY = nil
                        State.SpikePaused = false
                        State.SpikeStartTime = 0
                        RunService.Heartbeat:Wait()
                        continue
                    end
                end
                setStatus("Alvo caiu — aguardando...", Color3.fromRGB(255, 180, 100))

                for _, box in ipairs(prisonParts) do
                    if box and box.Parent then
                        box.CFrame = CFrame.new(0, -1000, 0)
                    end
                end
                RunService.Heartbeat:Wait()
                continue
            end

            if target then
                State.ActiveFlingTarget = target
                local tRoot = getRoot(target)
                local tHum = getHumanoid(target)
                local tTorso = getTorso(target)

                if tRoot and tRoot.Parent then
                    local refPos = (tTorso and tTorso.Position) or tRoot.Position

                    local vel = tRoot.AssemblyLinearVelocity
                    local velFlat = Vector3.new(vel.X, 0, vel.Z)
                    local speed = velFlat.Magnitude

                    if speed >= CFG.MoveVelocityThreshold then
                        State.PrisonMoving = true
                    elseif speed < CFG.StopVelocityThreshold then
                        State.PrisonMoving = false
                        State.PrisonDir = nil
                    end
                    local isMoving = State.PrisonMoving

                    if isMoving then
                        local newDir = getMoveDir(tRoot, tHum)
                        State.PrisonDir = updateLockedDir(State.PrisonDir, newDir)
                    end
                    local moveDir = State.PrisonDir or Vector3.zero
                    local hasMoveDir = moveDir.Magnitude > 0.1

                    local prediction = Vector3.zero
                    if speed > 1 then
                        prediction = velFlat * CFG.PrisonPredictionTime
                    end

                    local frontOffset = Vector3.zero
                    if isMoving and hasMoveDir then
                        frontOffset = moveDir * CFG.PrisonFrontOffset
                    end

                    local futurePos = refPos + prediction + frontOffset

                    local lookDir
                    if isMoving and hasMoveDir then
                        lookDir = moveDir
                    else
                        lookDir = tRoot.CFrame.LookVector
                    end

                    local radius = CFG.PrisonRadius

                    for i, box in ipairs(prisonParts) do
                        if box and box.Parent then
                            local angle = offsetAngles[i]
                            local off = Vector3.new(
                                math.cos(angle) * radius,
                                0,
                                math.sin(angle) * radius
                            )
                            box.CFrame = CFrame.new(futurePos + off, futurePos + off + lookDir)
                            box.AssemblyLinearVelocity = Vector3.zero
                            box.AssemblyAngularVelocity = Vector3.zero
                        end
                    end

                    local mode = isMoving and ("🔒 andando (front " .. CFG.PrisonFrontOffset .. ")") or "🔒 parado"
                    setStatus("PRISON em " .. target.Name .. " " .. mode, Color3.fromRGB(150, 220, 255))
                end
            end

            RunService.Heartbeat:Wait()
        end

        clearPrison()
    end)
end

