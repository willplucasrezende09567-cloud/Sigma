local function startFloatPlayer()
    if not State.Target and not State.AllMode then
        setStatus("Selecione um alvo ou ative ALL primeiro!", Color3.fromRGB(255, 120, 120))
        return
    end
    State.FloatPlayer = true
    State.FloatPlayerMoving = false
    State.FloatPlayerDir = nil
    State.FloatPlayerTargetStartY = nil
    State.FloatPlayerAirFrames = 0
    State.SpikePaused = false
    State.SpikeStartTime = 0
    saveMyPosition()
    applyNoclip()
    FloatBtn.Text = "PARAR FLOAT"
    FBStroke2.Color = Color3.fromRGB(255, 60, 60)

    local firstTarget = pickTarget("FLOAT")
    if firstTarget then spectate(firstTarget) end

    task.spawn(function()
        local stepUp = false

        while State.FloatPlayer do
            local char = LocalPlayer.Character
            if not char then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(0.2)
                char = LocalPlayer.Character
            end

            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    hum.PlatformStand = true

                    if hrp.Position.Y < CFG.VoidY + 15 then
                        if State.MyOriginalCFrame then
                            pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                        end
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity  = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        setStatus("Me safei do void!", Color3.fromRGB(255, 180, 100))
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "__BigHitbox" then
                            local isTorso = (d.Name == "UpperTorso" or d.Name == "Torso")
                            if d.CanCollide ~= isTorso then
                                d.CanCollide = isTorso
                            end
                        end
                    end

                    local target = pickTarget("FLOAT")

                    if target and isPlayerGone(target) then
                        if State.AllMode then
                            local alive = getAliveOthers()
                            if #alive > 0 then
                                State.AllIndex = (State.AllIndex % #alive) + 1
                                State.AllTargetStart = tick()
                                State.AllTargetStartY = nil
                                State.SpikePaused = false
                                State.SpikeStartTime = 0
                                State.FloatPlayerTargetStartY = nil
                                State.FloatPlayerAirFrames = 0
                                RunService.Heartbeat:Wait()
                                continue
                            else
                                setStatus("Todos saíram — parando", Color3.fromRGB(255, 120, 120))
                                State.FloatPlayer = false
                                break
                            end
                        else
                            setStatus("Alvo saiu do jogo — parando", Color3.fromRGB(255, 120, 120))
                            State.Target = nil
                            State.FloatPlayer = false
                            break
                        end
                    end

                    if not target or isDead(target) then
                        killFlingVelocity()
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                        State.SpikePaused = false
                        State.SpikeStartTime = 0
                        State.FloatPlayerTargetStartY = nil
                        State.FloatPlayerAirFrames = 0
                        if State.AllMode then
                            setStatus("Aguardando respawn... (" .. #getAliveOthers() .. " vivos)", Color3.fromRGB(255, 180, 100))
                        else
                            setStatus("Alvo morreu — aguardando respawn...", Color3.fromRGB(255, 180, 100))
                        end
                        RunService.Heartbeat:Wait()
                        continue
                    end

                    if target then
                        State.ActiveFlingTarget = target
                        local tRoot = getRoot(target)
                        local tHum = getHumanoid(target)
                        local tTorso = getTorso(target)

                        if tRoot and tRoot.Parent then
                            local spiked = shouldPauseForSpike(target)
                            if spiked then
                                if not State.SpikePaused then
                                    State.SpikePaused = true
                                    State.SpikeStartTime = tick()
                                    killFlingVelocity()
                                    pcall(function()
                                        hrp.AssemblyLinearVelocity  = Vector3.zero
                                        hrp.AssemblyAngularVelocity = Vector3.zero
                                        hrp.Velocity    = Vector3.zero
                                        hrp.RotVelocity = Vector3.zero
                                    end)
                                    setStatus("SPIKE — float pausado", Color3.fromRGB(255, 220, 100))
                                end

                                if State.MyOriginalCFrame then
                                    pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
                                end
                                hum.PlatformStand = true

                                if not State.Spectating then spectate(target) end

                                RunService.Heartbeat:Wait()
                                continue
                            else
                                if State.SpikePaused then
                                    State.SpikePaused = false
                                    State.SpikeStartTime = 0
                                    setStatus("Spike acabou — float retomando!", Color3.fromRGB(100, 255, 150))
                                end

                                if not State.FloatPlayerTargetStartY then
                                    State.FloatPlayerTargetStartY = tRoot.Position.Y
                                end

                                if isTargetInAir(target, State.FloatPlayerTargetStartY) then
                                    State.FloatPlayerAirFrames = State.FloatPlayerAirFrames + 1
                                else
                                    State.FloatPlayerAirFrames = 0
                                end
                                if State.FloatPlayerAirFrames >= CFG.AirMinFrames then
                                    setStatus("Alvo no ar — float player parado", Color3.fromRGB(255, 180, 100))
                                    State.FloatPlayer = false
                                    break
                                end

                                stepUp = not stepUp
                                local yOffset = stepUp and CFG.FloatStepUp or 0

                                local refPos = (tTorso and tTorso.Position) or tRoot.Position

                                local targetVel = tRoot.AssemblyLinearVelocity.Magnitude
                                if targetVel >= CFG.MoveVelocityThreshold then
                                    State.FloatPlayerMoving = true
                                elseif targetVel < CFG.StopVelocityThreshold then
                                    State.FloatPlayerMoving = false
                                    State.FloatPlayerDir = nil
                                end
                                local isMoving = State.FloatPlayerMoving

                                if isMoving then
                                    local newDir = getMoveDir(tRoot, tHum)
                                    State.FloatPlayerDir = updateLockedDir(State.FloatPlayerDir, newDir)
                                end
                                local moveDir = State.FloatPlayerDir or Vector3.zero
                                local hasMoveDir = moveDir.Magnitude > 0.1

                                local velY = tRoot.AssemblyLinearVelocity.Y
                                local isFalling = velY < CFG.FloatFallThreshold
                                local isRising = velY > CFG.FloatRisingThreshold

                                local basePos
                                if isRising and isMoving and hasMoveDir then
                                    basePos = refPos + (moveDir * CFG.FloatFrontOffset) + Vector3.new(0, CFG.FloatRisingOffset, 0)
                                elseif isRising then
                                    basePos = refPos + Vector3.new(0, CFG.FloatRisingOffset, 0)
                                elseif isFalling and isMoving and hasMoveDir then
                                    basePos = refPos + (moveDir * CFG.FloatFrontOffset) - Vector3.new(0, CFG.FloatFallOffset, 0)
                                elseif isFalling then
                                    basePos = refPos - Vector3.new(0, CFG.FloatFallOffset, 0)
                                elseif isMoving and hasMoveDir then
                                    basePos = refPos + (moveDir * CFG.FloatFrontOffset)
                                else
                                    basePos = refPos - Vector3.new(0, CFG.FloatOffset, 0)
                                end

                                local posDest = basePos + Vector3.new(0, yOffset, 0)

                                hrp.CFrame = CFrame.lookAt(posDest, posDest + Vector3.new(0, 1, 0))

                                hrp.Velocity    = Vector3.new(0, CFG.FloatVelocity, 0)
                                hrp.RotVelocity = Vector3.zero

                                local bv = hrp:FindFirstChild("FlingVelocity")
                                if not bv then
                                    bv = Instance.new("BodyVelocity")
                                    bv.Name = "FlingVelocity"
                                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bv.Parent = hrp
                                end
                                bv.Velocity = Vector3.new(0, CFG.FloatVelocity, 0)

                                local mode
                                if isRising and isMoving and hasMoveDir then
                                    mode = "acima+frente (subindo e andando)"
                                elseif isRising then
                                    mode = "acima " .. CFG.FloatRisingOffset .. " studs (subindo)"
                                elseif isFalling and isMoving and hasMoveDir then
                                    mode = "abaixo+frente (caindo e andando)"
                                elseif isFalling then
                                    mode = "abaixo (caindo)"
                                elseif isMoving and hasMoveDir then
                                    mode = "à frente " .. CFG.FloatFrontOffset .. " studs [dir travada]"
                                else
                                    mode = "abaixo do torso"
                                end
                                setStatus("FLOATANDO " .. target.Name .. " ☁️ (" .. mode .. ")", Color3.fromRGB(180, 220, 255))
                            end
                        end
                    end
                end
            end

            RunService.Heartbeat:Wait()
        end

        stopFloatPlayer()
    end)
end

