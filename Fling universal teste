    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bv = hrp:FindFirstChild("FlingVelocity")
    if bv then bv:Destroy() end
end

local function saveMyPosition()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then State.MyOriginalCFrame = hrp.CFrame end
end

local function restoreMyCamera()
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if myHum then
        pcall(function()
            Camera.CameraSubject = myHum
            Camera.CameraType = Enum.CameraType.Custom
        end)
    end
end

local function cleanupAndReturn()
    killFlingVelocity()
    removeNoclip()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hrp and hum then
        pcall(function() hum.PlatformStand = false end)
        pcall(function()
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.Velocity    = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end)
        if State.MyOriginalCFrame then
            pcall(function() hrp.CFrame = State.MyOriginalCFrame end)
        end
    end
    State.MyOriginalCFrame = nil
    State.SpikePaused = false
    State.SpikeStartTime = 0
    restoreMyCamera()
end

-- ============ ESPECTADOR ============
local function spectate(target)
    if State.Spectating then return end
    local char = target and target.Character
    if not char then return end
    local tHum = char:FindFirstChildOfClass("Humanoid")
    if not tHum then return end
    State.OrigCamSubject = Camera.CameraSubject
    State.OrigCamType = Camera.CameraType
    Camera.CameraSubject = tHum
    Camera.CameraType = Enum.CameraType.Custom
    State.Spectating = true
end

local function stopSpectate()
    if not State.Spectating then return end
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if myHum then
        Camera.CameraSubject = myHum
        Camera.CameraType = Enum.CameraType.Custom
    else
        task.spawn(function()
            local newChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local newHum = newChar:WaitForChild("Humanoid", 3)
            if newHum then
                pcall(function()
                    Camera.CameraSubject = newHum
                    Camera.CameraType = Enum.CameraType.Custom
                end)
            end
        end)
    end
    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
    end)
    State.OrigCamSubject = nil
    State.OrigCamType = nil
    State.Spectating = false
end

task.spawn(function()
    while ScreenGui.Parent do
        if State.Spectating then
            local t = State.ActiveFlingTarget or State.Target
            local char = t and t.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and Camera.CameraSubject ~= hum then
                pcall(function()
                    Camera.CameraSubject = hum
                    Camera.CameraType = Enum.CameraType.Custom
                end)
            end
            if not hum then
                local myChar = LocalPlayer.Character
                local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                if myHum and Camera.CameraSubject ~= myHum then
                    pcall(function()
                        Camera.CameraSubject = myHum
                        Camera.CameraType = Enum.CameraType.Custom
                    end)
                end
            end
        end
        task.wait(0.25)
    end
end)

