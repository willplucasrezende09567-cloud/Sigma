local function notify(msg)
    local Notification = Instance.new("TextLabel")
    Notification.Size = UDim2.new(0, 260, 0, 30)
    Notification.Position = UDim2.new(0.5, -130, 0, 20)
    Notification.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Notification.BackgroundTransparency = 0.4
    Notification.Text = msg
    Notification.TextColor3 = Color3.fromRGB(0, 230, 255)
    Notification.TextSize = 14
    Notification.Font = Enum.Font.GothamBold
    Notification.Parent = ScreenGui

    local NC = Instance.new("UICorner")
    NC.CornerRadius = UDim.new(0, 8)
    NC.Parent = Notification

    local NS = Instance.new("UIStroke")
    NS.Color = Color3.fromRGB(0, 230, 255)
    NS.Thickness = 1
    NS.Transparency = 0.4
    NS.Parent = Notification

    task.delay(2, function()
        TweenService:Create(Notification, TweenInfo.new(0.5), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        TweenService:Create(NS, TweenInfo.new(0.5), {Transparency = 1}):Play()
        task.wait(0.6)
        Notification:Destroy()
    end)
end

-- ============ LÓGICA DAS COORDENADAS ============
local function getPos()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return hrp.Position
end

-- Atualiza em tempo real
local conn
conn = RunService.RenderStepped:Connect(function()
    local pos = getPos()
    if pos then
        VX.Text = string.format("%.2f", pos.X)
        VY.Text = string.format("%.2f", pos.Y)
        VZ.Text = string.format("%.2f", pos.Z)
    else
        VX.Text = "--"
        VY.Text = "--"
        VZ.Text = "--"
    end
end)

-- Copiar para clipboard
CopyBtn.MouseButton1Click:Connect(function()
    local pos = getPos()
    if not pos then
        notify("⚠  Coordenadas indisponíveis")
        return
    end
    local txt = string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
    local ok = pcall(function()
        if setclipboard then
            setclipboard(txt)
        elseif toclipboard then
            toclipboard(txt)
        else
            error("Sem função de clipboard")
        end
    end)
    if ok then
        notify("✔  Copiado: " .. txt)
    else
        notify("✖  Falha ao copiar")
    end
end)

