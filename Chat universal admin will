local function addMessageToGui(msgId, senderName, senderId, messageText, color)
    if messageData[msgId] then return end
    messageData[msgId] = {
        sender = senderName, senderId = senderId,
        text = messageText, color = color,
    }
    messageOrder = messageOrder + 1

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 20)
    btn.BackgroundTransparency = 1
    btn.AutoButtonColor = false
    btn.Text = senderName .. ": " .. messageText
    btn.TextColor3 = color
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.TextWrapped = true
    btn.AutomaticSize = Enum.AutomaticSize.Y
    btn.LayoutOrder = messageOrder
    btn.Parent = messagesFrame
    messageButtons[msgId] = btn

    btn.MouseButton1Click:Connect(function()
        openContextMenu(btn, msgId)
    end)

    task.wait()
    messagesFrame.CanvasSize = UDim2.new(0, 0, 0, messageLayout.AbsoluteContentSize.Y + 12)
    messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.AbsoluteCanvasSize.Y)

    -- Limita quantidade
    local msgs = {}
    for _, child in pairs(messagesFrame:GetChildren()) do
        if child:IsA("TextButton") then table.insert(msgs, child) end
    end
    if #msgs > MAX_MESSAGES then
        table.sort(msgs, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        local oldest = msgs[1]
        for mid, ref in pairs(messageButtons) do
            if ref == oldest then
                messageButtons[mid] = nil
                messageData[mid] = nil
                break
            end
        end
        oldest:Destroy()
    end
end

