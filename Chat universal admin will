-- ===== REMOVER CHÃO =====
local removedParts = {}
local function removeFloor()
    removedParts = {}
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then terrain:Clear() end
    local keywords = { "floor", "ground", "baseplate", "chao", "chão", "groundpart", "grass" }
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(player.Character or workspace) then
            local lower = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if lower:find(kw) then
                    table.insert(removedParts, { part=obj, parent=obj.Parent })
                    obj.Parent = nil
                    break
                end
            end
        end
    end
    addSystemMessage("Chão removido (" .. #removedParts .. " partes)", Color3.fromRGB(255, 160, 60))
end

local function restoreFloor()
    local count = 0
    for _, e in ipairs(removedParts) do
        if e.part and e.parent then
            e.part.Parent = e.parent
            count = count + 1
        end
    end
    removedParts = {}
    addSystemMessage("Chão restaurado (" .. count .. " partes)", Color3.fromRGB(80, 220, 100))
end

-- ===== POLLING =====
local state = {
    chatSince=nil, presSince=nil, admSince=nil, likeSince=nil, pinSince=nil,
    firstChat=true, firstPres=true, firstAdm=true, firstLike=true, firstPin=true,
    connected=false,
}

local function pollTopic(topic, sinceId, firstTime)
    local url
    if firstTime or not sinceId then
        url = "https://ntfy.sh/" .. topic .. "/json?poll=1&since=10m"
    else
        url = "https://ntfy.sh/" .. topic .. "/json?poll=1&since=" .. sinceId
    end
    local ok, res = pcall(function() return req({ Url=url, Method="GET" }) end)
    if not ok or not res or not res.Body then return nil, false end
    local items, lastId = {}, sinceId
    for line in res.Body:gmatch("[^\n]+") do
        local ok2, data = pcall(function() return HttpService:JSONDecode(line) end)
        if ok2 and data and data.event == "message" and data.id then
            lastId = data.id
            table.insert(items, data)
        end
    end
    return items, true, lastId
end

task.spawn(function()
    if not req then
        addSystemMessage("Executor sem HTTP.", Color3.fromRGB(255, 100, 100))
        return
    end

    task.spawn(function()
        while true do
            pcall(function()
                req({ Url="https://ntfy.sh/"..PRESENCE_TOPIC, Method="POST",
                      Body=player.UserId.."|"..player.Name,
                      Headers={["Content-Type"]="text/plain"} })
            end)
            task.wait(HEARTBEAT_INTERVAL)
        end
    end)

    local doneChat, doneAdm, doneLike, donePin = {}, {}, {}, {}

    while true do
        -- CHAT
        local items, ok, last = pollTopic(CHAT_TOPIC, state.chatSince, state.firstChat)
        if ok then
            state.connected = true
            state.firstChat = false
            state.chatSince = last
            for _, d in ipairs(items or {}) do
                if not doneChat[d.id] then
                    doneChat[d.id] = true
                    local uid, uname, hex, msgId, msg = d.message:match("(%d+)|([^|]+)|(%x%x%x%x%x%x)|([^|]+)|(.+)")
                    if uid and uname and hex and msgId and msg then
                        local userId = tonumber(uid)
                        if userId ~= player.UserId then
                            local c = hexToColor(hex)
                            addMessageToGui(msgId, uname, userId, msg, c)
                            showBubble(userId, uname, msg, c)
                        end
                    end
                end
            end
        end

        -- PRESENCE
        local pItems, pOk, pLast = pollTopic(PRESENCE_TOPIC, state.presSince, state.firstPres)
        if pOk then
            state.firstPres = false
            state.presSince = pLast
            local now = tick()
            for _, d in ipairs(pItems or {}) do
                local uid, uname = d.message:match("(%d+)|(.+)")
                if uid then
                    local userId = tonumber(uid)
                    onlineUsers[userId] = onlineUsers[userId] or {}
                    onlineUsers[userId].name = uname
                    onlineUsers[userId].lastSeen = now
                    onlineUsers[userId].color = (userId == player.UserId)
                        and Color3.fromRGB(80, 220, 100)
                        or Color3.fromRGB(180, 200, 255)
                end
            end
            renderUsers()
        end

        -- ADMIN
        local aItems, aOk, aLast = pollTopic(ADMIN_TOPIC, state.admSince, state.firstAdm)
        if aOk then
            state.firstAdm = false
            state.admSince = aLast
            for _, d in ipairs(aItems or {}) do
                if not doneAdm[d.id] then
                    doneAdm[d.id] = true
                    if d.message == "REMOVE_FLOOR" then removeFloor()
                    elseif d.message == "RESTORE_FLOOR" then restoreFloor() end
                end
            end
        end

        -- LIKE
        local lItems, lOk, lLast = pollTopic(LIKE_TOPIC, state.likeSince, state.firstLike)
        if lOk then
            state.firstLike = false
            state.likeSince = lLast
            for _, d in ipairs(lItems or {}) do
                if not doneLike[d.id] then
                    doneLike[d.id] = true
                    local action, uidStr, msgId = d.message:match("(%u+)|(%d+)|(.+)")
                    if action and uidStr and msgId then
                        local uid = tonumber(uidStr)
                        if uid ~= player.UserId then
                            likes[msgId] = likes[msgId] or {}
                            if action == "LIKE" then
                                likes[msgId][uid] = true
                            elseif action == "UNLIKE" then
                                likes[msgId][uid] = nil
                            end
                            updateMessageText(msgId)
                        end
                    end
                end
            end
        end

        -- PIN
        local piItems, piOk, piLast = pollTopic(PIN_TOPIC, state.pinSince, state.firstPin)
        if piOk then
            state.firstPin = false
            state.pinSince = piLast
            for _, d in ipairs(piItems or {}) do
                if not donePin[d.id] then
                    donePin[d.id] = true
                    if d.message == "UNPIN" then
                        pinnedMessage = nil
                        updatePinnedDisplay()
                    else
                        local msgId, uname, hex, text = d.message:match("PIN|([^|]+)|([^|]+)|(%x%x%x%x%x%x)|(.+)")
                        if msgId and uname and hex and text then
                            pinnedMessage = {
                                msgId = msgId,
                                sender = uname,
                                text = text,
                                color = hexToColor(hex),
                            }
                            updatePinnedDisplay()
                        end
                    end
                end
            end
        end

        statusDot.BackgroundColor3 = state.connected
            and Color3.fromRGB(80, 220, 100)
            or Color3.fromRGB(255, 80, 80)

        task.wait(POLL_INTERVAL)
    end
end)

